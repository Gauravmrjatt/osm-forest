{
  "name": "osm-army-fortress",
  "version": "1.0.0",
  "description": "Ultra-Secure Gift Code Distribution System - 5000+ Security Layers with Daily Mutation Engine",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.js",
    "test:unit": "node --test tests/unit/**/*.js",
    "test:integration": "node --test tests/integration/**/*.js",
    "test:security": "node --test tests/security/**/*.js",
    "test:coverage": "node --test --experimental-test-coverage tests/**/*.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit",
    "mutate:now": "node -e \"import('./cron/mutate.js').then(m => m.runNow())\"",
    "cleanup:now": "node -e \"import('./cron/cleanup.js').then(m => m.runNow())\"",
    "cron:start": "node cron/runner.js",
    "cron:stop": "node -e \"process.exit(0)\"",
    "bot:start": "node services/bot.js",
    "logs": "tail -f logs/app.log",
    "logs:error": "tail -f logs/error.log",
    "docker:build": "docker build -t osm-fortress .",
    "docker:run": "docker run -p 3000:3000 --env-file .env osm-fortress",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f fortress",
    "generate:secret": "node -e \"import('crypto').then(c => console.log(c.randomBytes(64).toString('hex')))\"",
    "generate:aes": "node -e \"import('crypto').then(c => console.log(c.randomBytes(32).toString('hex')))\"",
    "generate:hmac": "node -e \"import('crypto').then(c => console.log(c.randomBytes(64).toString('hex')))\""
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "mongodb": "^6.3.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.64.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "security",
    "gift-codes",
    "encryption",
    "anti-bot",
    "telegram",
    "osm-army",
    "mutation-engine",
    "cryptographic",
    "fortress"
  ],
  "author": "OSM Army Security Team",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/osmarmy/fortress.git"
  },
  "osm-fortress": {
    "version": "1.0.0",
    "securityLayers": 5000,
    "mutationSchedule": "daily",
    "encryptionStandard": "AES-256-GCM",
    "minNodeVersion": "18.0.0"
  }
}
